rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          !('lifecycleState' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lifecycleState == 'active'
        );
    }

    function isAdmin() {
      return activeUser() &&
        'admin' in request.auth.token &&
        request.auth.token.admin == true;
    }

    function isSelf(userId) {
      return activeUser() && request.auth.uid == userId;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/chatRooms/$(roomId);
    }

    function roomExists(roomId) {
      return exists(roomPath(roomId));
    }

    function isRoomMember(roomId) {
      return activeUser() &&
        roomExists(roomId) &&
        request.auth.uid in get(roomPath(roomId)).data.members;
    }

    function isRoomResourceMember() {
      return activeUser() && request.auth.uid in resource.data.members;
    }

    function roomAcceptsWrites(roomId) {
      return roomExists(roomId) &&
        get(roomPath(roomId)).data.get('deletionState', 'active') == 'active';
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function lifecycleFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lifecycleState',
        'lifecycleVersion',
        'activeOperationId'
      ]);
    }

    function projectIsActive(projectId) {
      let path = /databases/$(database)/documents/projects/$(projectId);
      return exists(path) &&
        (!('lifecycleState' in get(path).data) || get(path).data.lifecycleState == 'active') &&
        (!('pendingDelete' in get(path).data) || get(path).data.pendingDelete != true);
    }

    function projectLifecycleFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lifecycleState',
        'lifecycleVersion',
        'operationId',
        'pendingDelete'
      ]);
    }

    function startsProjectDeletion() {
      return resource.data.get('lifecycleState', 'active') == 'active' &&
        request.resource.data.lifecycleState == 'deleting' &&
        request.resource.data.lifecycleVersion == resource.data.get('lifecycleVersion', 0) + 1 &&
        request.resource.data.operationId is string &&
        changedOnly(['lifecycleState', 'lifecycleVersion', 'operationId', 'updatedAt']);
    }

    function createsOwnMessage(roomId) {
      return isRoomMember(roomId) &&
        roomAcceptsWrites(roomId) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.chatRoomId == roomId;
    }

    function updatesOwnReadBy(roomId) {
      let oldReadBy = resource.data.get('readBy', []);
      let newReadBy = request.resource.data.get('readBy', []);
      return isRoomMember(roomId) &&
        changedOnly(['readBy']) &&
        newReadBy.hasAll(oldReadBy) &&
        (
          (request.auth.uid in oldReadBy && newReadBy.size() == oldReadBy.size()) ||
          (!(request.auth.uid in oldReadBy) &&
            request.auth.uid in newReadBy &&
            newReadBy.size() == oldReadBy.size() + 1)
        );
    }

    function updatesOwnReactions(roomId) {
      let oldReactions = resource.data.get('reactionsByUser', {});
      let newReactions = request.resource.data.get('reactionsByUser', {});
      return isRoomMember(roomId) &&
        changedOnly(['reactionsByUser']) &&
        newReactions.diff(oldReactions).affectedKeys().hasOnly([request.auth.uid]);
    }

    function updatesPin(roomId) {
      return isRoomMember(roomId) && changedOnly(['isPinned']);
    }

    function senderUpdatesOwnMessage(roomId) {
      // 退出済み（members から外れた）ユーザーが過去の自分のメッセージを
      // 改ざんできないよう、送信者本人かつ現メンバーであることを要求する
      return isRoomMember(roomId) &&
        resource.data.senderId == request.auth.uid &&
        changedOnly([
          'text',
          'title',
          'isEdited',
          'isDeleted',
          'imageURL',
          'fileURL',
          'storagePath',
          'fileSize',
          'fileName',
          'fileType',
          'attachmentState',
          'attachmentOperationId',
          'attachmentError',
          'colorId',
          'noteType',
          'checkItems',
          'orderIndex',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if activeUser();
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.get('lifecycleState', 'active') == 'active';
      allow update: if lifecycleFieldsUnchanged() && (isAdmin() ||
        (isSelf(userId) && changedOnly([
          'displayName',
          'photoURL',
          'photoStoragePath',
          'photoFileSize'
        ])));
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isSelf(userId) || isAdmin();
      }

      match /notificationSettings/{roomId} {
        allow read, write, delete: if isSelf(userId) || isAdmin();
      }

      // サーバーだけが作成する工程管理通知。本人以外の購読と通知の偽造を禁止。
      match /processNotifications/{notificationId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    match /userDeletionOperations/{operationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read, create, update, delete: if activeUser();
    }

    // ===== 工程管理（process management）=====
    // 行動予定表(schedules)とは完全に独立したコレクション群。
    // 業務要件「権限を分けない（ログイン者は全員 read/write 可）」のため、
    // chatRooms のようなフィールド単位ホワイトリストは使わない。
    // 縛るのは「作成者の詐称防止」と「createdBy / projectId の不変」のみ。
    // 物理削除は Cloud Function(Admin SDK)だけが行うため、クライアントの delete は全面禁止。

    // プロジェクト本体。削除はクライアント不可（update で pendingDelete:true を立て、Function が実削除）。
    match /projects/{projectId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.createdBy == request.auth.uid   // 作成者の詐称防止
        && request.resource.data.name is string
        && request.resource.data.lifecycleState == 'active'
        && request.resource.data.lifecycleVersion == 0;
      allow update: if activeUser()
        && request.resource.data.createdBy == resource.data.createdBy
        && (projectLifecycleFieldsUnchanged() || startsProjectDeletion());
      allow delete: if false;   // 物理削除は Function のみ
    }

    // タスク。projectId は不変（別PJへの付け替えを防ぐ）。
    // タスクはサブコレクションを持たない単一ドキュメントなので、削除はクライアントから許可する
    // （プロジェクト削除のような Function バッチは不要）。プロジェクト本体の物理削除のみ Function 専用。
    match /tasks/{taskId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.createdBy == request.auth.uid   // 作成者の詐称防止
        && request.resource.data.projectId is string
        && projectIsActive(request.resource.data.projectId);
      allow update: if activeUser()
        && request.resource.data.projectId == resource.data.projectId   // projectId は不変
        && request.resource.data.createdBy == resource.data.createdBy
        && projectIsActive(resource.data.projectId);   // createdBy は不変
      allow delete: if activeUser() && projectIsActive(resource.data.projectId);
    }

    // 工程管理メンバー（担当者マスタ）。当面は delete も許容（将来は無効化フラグへ移行）。
    match /processMembers/{memberId} {
      allow read: if activeUser();
      allow create, update: if activeUser() && request.resource.data.name is string;
      allow delete: if activeUser();
    }

    // ===== 工程管理ここまで =====

    match /chatRooms/{roomId} {
      allow read: if isAdmin() || isRoomResourceMember();
      allow create: if activeUser() &&
        request.auth.uid in request.resource.data.members &&
        (
          !request.resource.data.keys().hasAny(['createdBy']) ||
          request.resource.data.createdBy == request.auth.uid
        ) &&
        (
          !request.resource.data.keys().hasAny(['deletionState']) ||
          request.resource.data.deletionState == 'active'
        );
      allow update: if isAdmin() ||
        (
          isRoomResourceMember() &&
          resource.data.get('deletionState', 'active') == 'active' &&
          changedOnly([
            'name',
            'photoURL',
            'photoStoragePath',
            'photoFileSize',
            'members',
            'memberDetails',
            'favorites',
            'lastMessage',
            'updatedAt'
          ])
        );
      allow delete: if false;

      match /readStates/{userId} {
        allow read: if isAdmin() || isRoomMember(roomId);
        allow create: if isSelf(userId) &&
          isRoomMember(roomId) &&
          roomAcceptsWrites(roomId) &&
          request.resource.data.keys().hasOnly(['lastReadAt', 'version', 'eventId']) &&
          request.resource.data.version == 1 &&
          request.resource.data.eventId is string;
        allow update: if isSelf(userId) &&
          isRoomMember(roomId) &&
          roomAcceptsWrites(roomId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt', 'version', 'eventId']) &&
          request.resource.data.version == resource.data.get('version', 0) + 1 &&
          request.resource.data.eventId is string;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isAdmin() || isRoomMember(roomId);
        allow create: if createsOwnMessage(roomId);
        allow update: if isAdmin() ||
          senderUpdatesOwnMessage(roomId) ||
          updatesOwnReadBy(roomId) ||
          updatesOwnReactions(roomId) ||
          updatesPin(roomId);
        allow delete: if isAdmin() ||
          (isRoomMember(roomId) && resource.data.senderId == request.auth.uid);
      }
    }

    // プレビューのキャッシュは Functions だけが読み書きする。
    match /linkPreviews/{previewId} {
      allow read, write: if false;
    }
  }
}
