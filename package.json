{
  "name": "artics",
  "private": true,
  "version": "1.3.3",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "node scripts/check-env.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "prebuild:electron": "node scripts/check-env.mjs",
    "lint": "eslint .",
    "test": "vitest run tests/lib",
    "test:watch": "vitest --watch tests/lib",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "dev:electron": "vite --config vite.electron.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json && vite build --config vite.electron.config.ts && electron-builder",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-artics-refactor \"vitest run tests/rules --no-file-parallelism\"",
    "test:integration:user-lifecycle": "firebase emulators:exec --only auth,firestore,storage,functions,database,pubsub --project demo-artics-refactor \"node functions/test/userLifecycle.emulator.mjs\"",
    "test:integration:room-lifecycle": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,storage,functions,database,pubsub --project demo-artics-refactor \"node functions/test/roomLifecycle.emulator.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && playwright test --config=playwright.preview.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:electron": "tsc -p tsconfig.electron.json && vite build --config vite.electron.config.ts && playwright test --config=playwright.electron.config.ts",
    "import:schedules": "node scripts/notion-schedule-csv-to-json.mjs",
    "import:schedules:dry-run": "node scripts/notion-schedule-csv-to-json.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@react-pdf/renderer": "^4.5.1",
    "@svar-ui/react-gantt": "^2.7.0",
    "browser-image-compression": "^2.0.2",
    "electron-updater": "^6.7.3",
    "firebase": "^12.8.0",
    "fractional-indexing": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.0.0",
    "globals": "^16.5.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.0"
  }
}
